      "plan_cancel_behavior": "single active linked allocation -> CANCELLED; no active linked allocation remains"
    }
  },
  "physical_cash_formula": "latest APPLIED reconciliation.production_cash_target + active-epoch production-wallet income - active-epoch production-wallet expense",
