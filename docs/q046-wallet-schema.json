  "production_migration_executed": false,
  "non_operating_financial_meanings": [
    "NON_OPERATING_LOAN_INFLOW",
    "NON_OPERATING_PARTNER_REPAYMENT",
    "NON_OPERATING_OWNER_DISTRIBUTION",
    "NON_OPERATING_OBLIGATION_PAYMENT"
  ],
  "order_future_completion_need": {
    "known": "sum of concrete active planned expense facts linked to the order plus active unlinked order-targeted wallet allocations",
    "unknown": "null with NOT_CALCULATED / «не рассчитано» when no supported linked fact or plan exists",
    "aggregate": "known_future_completion_cash_need_total excludes unknown orders"
  },
  "obligation_payment_guard": {
    "already_paid": "reject OBLIGATION_ALREADY_PAID",
    "overpayment": "reject OBLIGATION_PAYMENT_EXCEEDS_REMAINING",
    "exact_residual": "allowed",
    "clamp_overpayment": false,
    "next_payment_amount": "min(regular_payment_amount, remaining) when remaining > 0"
  }
